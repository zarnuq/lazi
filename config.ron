// lazi's configuration. lazi reads the first of $XDG_CONFIG_HOME/lazi/config.ron (usually
// ~/.config/lazi/config.ron) and $XDG_CONFIG_DIRS/lazi/config.ron (usually /etc/xdg), or the
// file given with --config. Nothing has a built-in default: every setting below is required,
// and an unbound key does nothing.
//
// The syntax is RON: (field: value) for structs, [a, b] for lists, {"key": value} for maps,
// Name or Name(args) for choices. r#"..."# is a raw string, which saves escaping quotes in shell
// snippets.
(
    show_hidden: true,
    // Width ratio of the parent, current and preview columns.
    ratio: (2, 5, 8),
    // Rows kept between the cursor and the edge when scrolling.
    scrolloff: 5,
    // Ask before trashing. Permanent deletes always ask.
    confirm_trash: true,
    // Colours for code previews: one of syntect's bundled themes, i.e. base16-ocean.dark,
    // base16-eighties.dark, base16-mocha.dark, base16-ocean.light, InspiredGitHub,
    // Solarized (dark) or Solarized (light).
    syntax_theme: "base16-ocean.dark",
    // Columns per tab stop in text previews.
    tab_size: 5,
    // Largest image size (pixels) sent to the terminal, whatever the preview area.
    image_max: (2500, 1500),
    // Preview commands running longer than this many seconds are killed.
    preview_timeout: 3.0,
    // Reads text on stdin, for CopyPath. [] disables copying.
    clipboard: ["wl-copy"],
    // Trashes files on another filesystem than the home trash; the path is the last argument.
    // [] makes that an error instead.
    trash_fallback: ["gio", "trash", "--"],

    // Each style takes fg and bg (a name like "blue" or "lightred", "#rrggbb", or a 256-colour
    // index like "208") and bold, dim, italic, underlined, reversed. Unset is the terminal's.
    style: (
        header: (fg: "green", bold: true),
        dir: (fg: "blue", bold: true),
        link: (fg: "cyan"),
        cursor: (reversed: true),
        error: (fg: "red"),
        dim: (dim: true),
        find: (fg: "yellow", underlined: true),
        // The bar left of a marked entry.
        mark_selected: (bg: "yellow"),
        mark_copied: (bg: "green"),
        mark_cut: (bg: "red"),
    ),

    // Programs to open files with, named for `rules` below. `run` is a `sh -c` snippet with the
    // files as "$@" ("$1" is the first). `block: true` hands it the terminal and waits; otherwise
    // it runs detached, and its error shows if it fails.
    openers: {
        "shell": (desc: "Shell here", run: r#"cd "$1" && exec "$SHELL""#, block: true),
        "edit": (desc: "$EDITOR", run: r#"${EDITOR:-nvim} "$@""#, block: true),
        "open": (desc: "Open", run: r#"xdg-open "$1""#),
        "reveal": (desc: "Reveal", run: r#"xdg-open "$(dirname "$1")""#),
        "view": (desc: "View", run: r#"swayimg "$1""#),
        "setbg": (desc: "Set wallpaper", run: r#"qs ipc call wallpaper set "$1""#),
        "read": (desc: "Read", run: r#"zathura "$1""#),
        "play": (desc: "Play", run: r#"mpv --force-window "$@""#),
        "mediainfo": (desc: "Media info", run: r#"mediainfo "$1"; echo "Press enter to exit"; read _"#, block: true),
        "extract": (desc: "Extract here", run: r#"for f; do bsdtar -xf "$f"; done"#),
    },

    // Which previewers and openers a file gets. The first matching rule wins. A rule matches on
    // all of: `dir: true` (directories match only these rules, files only the others), `ext`
    // (lowercase extensions) and `text: true` (no NUL in the first KB). A rule with none of them
    // catches every file.
    //
    // `preview` is tried in order until one works:
    //   Text            the file itself, syntax highlighted
    //   Image           decoded in process, shown with kitty's graphics protocol
    //   ImageCmd("...") a script printing an image (e.g. PNG) to stdout
    //   Cmd("...")      a script whose output is shown as text, ANSI colours kept
    // Scripts get the file as "$1" and the preview area as $COLUMNS and $LINES. Directories are
    // always previewed as a listing.
    //
    // `open` names openers: Open runs the first, OpenWith offers them all.
    rules: [
        (dir: true, open: ["shell", "edit", "reveal"]),
        (
            ext: ["png", "jpg", "jpeg", "gif", "webp", "bmp", "tif", "tiff", "svg", "avif", "heic", "ico", "jxl"],
            // ffmpeg handles what the built-in decoder can't (avif, heic, jxl, ...).
            preview: [Image, ImageCmd(r#"ffmpeg -v error -i "$1" -frames:v 1 -f image2pipe -c:v png -"#)],
            open: ["view", "setbg", "open", "reveal"],
        ),
        (
            ext: ["pdf", "epub", "djvu"],
            // Metadata only, without exiftool's own and the filesystem's.
            preview: [Cmd(r#"exiftool -S --File:all --ExifTool:all "$1""#)],
            open: ["read", "open", "reveal"],
        ),
        (
            ext: ["mp4", "mkv", "webm", "mov", "avi", "m4v", "flv", "wmv"],
            // A representative frame from the first couple of seconds, rather than a black first one.
            preview: [ImageCmd(r#"ffmpeg -v error -i "$1" -vf thumbnail=50 -frames:v 1 -f image2pipe -c:v png -"#)],
            open: ["play", "mediainfo", "reveal"],
        ),
        (
            ext: ["mp3", "flac", "ogg", "opus", "wav", "m4a", "aac", "wma"],
            preview: [Cmd(r#"exiftool -S --File:all --ExifTool:all "$1""#)],
            open: ["play", "mediainfo", "reveal"],
        ),
        (
            ext: ["zip", "tar", "gz", "tgz", "bz2", "xz", "txz", "zst", "7z", "rar", "iso", "cpio", "lz4"],
            preview: [Cmd(r#"bsdtar -tf "$1""#)],
            open: ["extract", "open", "reveal"],
        ),
        (text: true, preview: [Text], open: ["edit", "reveal"]),
        (preview: [Cmd(r#"file -b "$1""#)], open: ["open", "reveal"]),
    ],

    // Keys are written like "q", "Enter", "Ctrl+u", "Shift+PageUp" or "Ctrl+Alt+Left". Modifiers
    // are Ctrl, Alt, Shift and Super, joined with +. Spaces separate the keys of a sequence
    // ("g h", "Ctrl+x Ctrl+s"); a run of plain characters like "gg" is a sequence too. Named
    // keys: Enter Esc Tab BackTab Backspace Delete Insert Home End PageUp PageDown Up Down Left
    // Right Space F1-F24. A shifted letter is just the capital: "G", not "Shift+g".
    //
    // Most terminals never report Super, and some combinations (Ctrl+Shift+letter, Ctrl+Enter)
    // arrive as something else or not at all.
    keys: (
        normal: {
            "q": Quit,
            // Without writing --cwd-file, so the shell stays where it was.
            "Q": QuitNoCwd,
            "Ctrl+c": Quit,
            "k": Move(-1),
            "j": Move(1),
            "Up": Move(-1),
            "Down": Move(1),
            // Page moves by a percentage of the visible rows.
            "Ctrl+u": Page(-50),
            "Ctrl+d": Page(50),
            "Ctrl+b": Page(-100),
            "Ctrl+f": Page(100),
            "Shift+PageUp": Page(-50),
            "Shift+PageDown": Page(50),
            "PageUp": Page(-100),
            "PageDown": Page(100),
            "gg": Top,
            "G": Bottom,
            "h": Leave,
            "l": Enter,
            "Left": Leave,
            "Right": Enter,
            // History.
            "H": Back,
            "L": Forward,
            ".": ToggleHidden,
            // A leading ~ is $HOME; anything else is relative to the current directory.
            "gh": Goto("~"),
            "gc": Goto("~/.config"),
            "gd": Goto("~/Downloads"),
            "o": Open,
            "Enter": Open,
            "O": OpenWith,
            // Selects the hovered entry and moves down.
            "Space": ToggleSelect,
            "Ctrl+a": SelectAll,
            "Ctrl+r": InvertSelection,
            // Clears the selection, else the filter, else the find highlight.
            "Esc": Escape,
            "y": Yank,
            "x": Cut,
            "Y": Unyank,
            "X": Unyank,
            // Paste renames to name_1 on a clash; PasteOverwrite replaces.
            "p": Paste,
            "P": PasteOverwrite,
            "d": Trash,
            "D": Delete,
            // A directory if the name ends in /.
            "a": Create,
            "r": Rename,
            "/": Find,
            "?": FindBack,
            "n": FindNext,
            "N": FindPrev,
            "f": Filter,
            // Run is a `sh -c` snippet with the targets as "$@". `block: true` hands it the
            // terminal; `reveal: true` does too, then goes to the path it prints.
            "z": Run(run: "fzf", reveal: true),
            // CopyPath takes Path, Dir, Name or Stem (the name without its extension).
            "cc": CopyPath(Path),
            "cd": CopyPath(Dir),
            "cf": CopyPath(Name),
            "cn": CopyPath(Stem),
            "Ctrl+z": Suspend,
            // Scrolls the file preview by lines.
            "K": Seek(-5),
            "J": Seek(5),
        },
        // While the OpenWith menu is up. Pick counts from 1.
        menu: {
            "j": Down,
            "Down": Down,
            "k": Up,
            "Up": Up,
            "Enter": Accept,
            "o": Accept,
            "l": Accept,
            "1": Pick(1),
            "2": Pick(2),
            "3": Pick(3),
            "4": Pick(4),
            "5": Pick(5),
            "6": Pick(6),
            "7": Pick(7),
            "8": Pick(8),
            "9": Pick(9),
            "Esc": Cancel,
            "q": Cancel,
            "h": Cancel,
        },
        // While typing in a prompt (create, rename, find, filter). Unbound printable keys type
        // themselves. Complete is Tab completion in find, which moves into directories;
        // NextMatch and PrevMatch step through find's matches without closing the prompt.
        prompt: {
            "Enter": Submit,
            "Esc": Cancel,
            "Tab": Complete,
            "Shift+Tab": NextMatch,
            "Left": Left,
            "Right": Right,
            "Home": Home,
            "Ctrl+a": Home,
            "End": End,
            "Ctrl+e": End,
            "Backspace": Backspace,
            "Delete": Delete,
            // Back to the previous space or slash.
            "Ctrl+w": DeleteWord,
            "Ctrl+u": KillToStart,
            "Ctrl+k": KillToEnd,
        },
        // Keys that answer yes to a confirmation; anything else is no. The first is shown in
        // the question.
        confirm: ["y", "Y"],
    ),
)
