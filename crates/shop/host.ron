// shop's reference config. shop reads the first of --config PATH, $XDG_CONFIG_HOME/shop/host.ron
// and $XDG_CONFIG_DIRS/shop/host.ron. Every field is required; there are no built-in defaults.
(
    // Panels in tab order; the first has focus at start.
    //   Lazi(config, dir): config None is lazi's usual lookup, dir None is shop's working
    //   directory. lazi's config is per process, so a second Lazi panel uses the first's.
    //   Git(roots, depth, fetch_every, symbols, style, keys): repos found under each root, with
    //   zhimmer's status symbols. Keys are the panel's own; Run's $1 is the repo's path.
    panels: [
        Lazi(config: None, dir: None),
        Git(
            roots: ["~"],
            // Levels below each root to search; 2 finds ~/Projects/x but not repos kept deeper
            // (notes, downloads of downloads). Hidden directories and repos inside repos are skipped.
            depth: 2,
            // Seconds between background fetch rounds.
            fetch_every: 300,
            symbols: (
                untracked: "?", staged: "+", modified: "!", renamed: "»", deleted: "✘",
                unmerged: "=", ahead: "⇡", behind: "⇣", clean: "✓",
            ),
            style: (
                root: (fg: "#89b4fa", bold: true),
                branch: (fg: "#cba6f7"),
                status: (fg: "#f9e2af"),
                arrows: (fg: "#fab387"),
                clean: (fg: "#a6e3a1"),
                error: (fg: "#f38ba8"),
                // A background, not reversed: reversing turns every coloured span into a block.
                cursor: (bg: "#45475a"),
            ),
            keys: {
                "j": Down, "k": Up, "Down": Down, "Up": Up, "g g": Top, "G": Bottom,
                "Enter": Open, "l": Open,
                "r": Refresh,
                "?": Help,
                "g l": Run(run: "lazygit", block: true),
                // Everything uncommitted, staged or not, in git's pager; q comes back.
                "d": Run(run: "git diff HEAD", block: true),
                "p": Run(run: "git pull --ff-only", block: true),
                "P": Run(run: "git push", block: true),
                "t": Run(run: r#"kitty --directory "$1""#, block: false),
                "c": Run(run: r#"kitty --directory "$1" claude"#, block: false),
                "x": Run(run: r#"kitty --directory "$1" codex"#, block: false),
            },
        ),
    ],
    // Styles are written as in lazi's config.ron.
    style: (
        tab: (fg: "gray"),
        tab_focused: (fg: "black", bg: "blue"),
    ),
    // Keys are written as in lazi's config.ron. shop looks at every key first, except while a
    // panel takes text (a lazi prompt or its opener menu); whatever no binding here claims goes
    // to the focused panel.
    //   Next, Prev: the neighbouring panel, wrapping. (lazi binds H and L to its own.)
    //   Focus(n): the tab at position n, from 0; the tab bar numbers them from 1.
    //   Quit: quit shop. lazi's q closes a lazi tab, and quits shop on the last one.
    keys: {
        "1": Focus(0), "2": Focus(1), "3": Focus(2), "4": Focus(3), "5": Focus(4),
        "6": Focus(5), "7": Focus(6), "8": Focus(7), "9": Focus(8),
        "Ctrl+c": Quit,
    },
    // While the ? menu of key bindings is up. Other keys do nothing.
    help_keys: {
        "j": Down, "k": Up, "Down": Down, "Up": Up,
        "Ctrl+d": PageDown, "Ctrl+u": PageUp, "PageDown": PageDown, "PageUp": PageUp,
        "g g": Top, "G": Bottom,
        "Esc": Close, "q": Close, "?": Close,
    },
)
