// lazi's reference config. lazi reads the first of --config PATH, $XDG_CONFIG_HOME/lazi/config.ron
// and $XDG_CONFIG_DIRS/lazi/config.ron. Every field is required; there are no built-in defaults.
(
    // Panels in tab order; the first has focus at start.
    //   Files(config, dir): the file browser. config None reads lazi/files.ron as usual, dir None is
    //   lazi's working directory. Its config is per process, so a second Files panel uses the first's.
    //   Git(roots, fetch_every, symbols, style, keys): repos found under each root, with
    //   zhimmer's status symbols. Keys are the panel's own; Run's $1 is the repo's path.
    // Reopen the tabs lazi had when it last quit (saved in ~/.local/state/lazi/session). Tab 1
    // always opens where lazi is started, or in DIR; the other files tabs keep their folders until
    // closed.
    restore: true,
    panels: [
        Files(config: None, dir: None),
        // A start page, like Doom Emacs's: these shortcuts, then the files opened last (from the file browser,
        // the search box or here) and the folders visited last, `recent` of each. Search opens the search box with that query typed; Goto shows
        // the folder in the file browser; Edit opens the file with search.open.
        Dashboard(
            recent: 10,
            menu: [
                (key: "p", label: "Open project", run: Search("repo:.")),
                (key: "s", label: "Search", run: Search("")),
                (key: "h", label: "Home folder", run: Goto("~")),
                (key: "c", label: "Open lazi config", run: Edit("~/.config/lazi/config.ron")),
                (key: "L", label: "Open file browser config", run: Edit("~/.config/lazi/files.ron")),
            ],
            style: (
                title: (fg: "#89b4fa", bold: true),
                key: (fg: "#cba6f7"),
                cursor: (bg: "#45475a"),
            ),
            keys: {
                "j": Down, "k": Up, "Down": Down, "Up": Up, "g g": Top, "G": Bottom,
                "Enter": Open, "l": Open, "Ctrl+r": Reveal,
                "?": Help,
            },
        ),
        Git(
            // Folders to track, each searched `depth` levels down: 2 finds ~/Projects/x but not
            // repos kept deeper (notes, downloads of downloads). Hidden directories and repos inside
            // repos are skipped. Depth 0 tracks the folder itself, for one repo kept deeper. To track
            // only some folders: [(path: "~/Projects", depth: 1), (path: "~/CCSO", depth: 1)].
            roots: [
                (path: "~", depth: 2),
            ],
            // Seconds between background fetch rounds.
            fetch_every: 300,
            symbols: (
                untracked: "?", staged: "+", modified: "!", renamed: "»", deleted: "✘",
                unmerged: "=", ahead: "⇡", behind: "⇣", clean: "✓",
            ),
            style: (
                root: (fg: "#89b4fa", bold: true),
                branch: (fg: "#cba6f7"),
                status: (fg: "#f9e2af"),
                arrows: (fg: "#fab387"),
                clean: (fg: "#a6e3a1"),
                error: (fg: "#f38ba8"),
                // A background, not reversed: reversing turns every coloured span into a block.
                cursor: (bg: "#45475a"),
                // Diff lines in the status view.
                added: (fg: "#a6e3a1"),
                removed: (fg: "#f38ba8"),
                hunk: (fg: "#89b4fa"),
            ),
            keys: {
                "j": Down, "k": Up, "Down": Down, "Up": Up, "g g": Top, "G": Bottom,
                "Enter": Open, "l": Open,
                "r": Refresh,
                "?": Help,
                "g l": Run(run: "lazygit", block: true),
                // The repo's status, like magit's: stage, unstage, discard and diff file by file.
                "d": Status,
                "p": Run(run: "git pull --ff-only", block: true),
                "P": Run(run: "git push", block: true),
                "t": Run(run: r#"kitty --directory "$1""#, block: false),
                "c": Run(run: r#"kitty --directory "$1" claude"#, block: false),
                "x": Run(run: r#"kitty --directory "$1" codex"#, block: false),
            },
            // In the status view. Run's $1 is the repo and $2 the file under the cursor; staging
            // and commits made by a detached Run show up by themselves.
            status_keys: {
                "j": Down, "k": Up, "Down": Down, "Up": Up, "g g": Top, "G": Bottom,
                "Tab": Toggle,
                "s": Stage, "u": Unstage,
                // Asks for x again before throwing anything away.
                "x": Discard,
                "Enter": Open,
                "r": Refresh,
                "q": Close, "Esc": Close, "h": Close,
                "?": Help,
                "S": Run(run: "git add -A", block: false),
                "U": Run(run: "git reset -q", block: false),
                "c": Run(run: "git commit", block: true),
                "A": Run(run: "git commit --amend", block: true),
                // Everything uncommitted, staged or not, in git's pager; q comes back.
                "d": Run(run: "git diff HEAD", block: true),
                "p": Run(run: "git pull --ff-only", block: true),
                "P": Run(run: "git push", block: true),
            },
        ),
    ],
    // Styles are written as in files.ron.
    style: (
        tab: (fg: "gray"),
        tab_focused: (fg: "black", bg: "blue"),
    ),
    // Keys are written as in files.ron. lazi looks at every key first, except while a panel takes
    // text (a files prompt or its opener menu); whatever no binding here claims goes to the
    // focused panel.
    //   Next, Prev: the neighbouring panel, wrapping. (the files tab binds H and L to its own.)
    //   Focus(n): the tab at position n, from 0; the tab bar numbers them from 1.
    //   Quit: quit lazi. q in a files tab closes it, and quits lazi on tab 1.
    keys: {
        "1": Focus(0), "2": Focus(1), "3": Focus(2), "4": Focus(3), "5": Focus(4),
        "6": Focus(5), "7": Focus(6), "8": Focus(7), "9": Focus(8),
        "Ctrl+c": Quit,
        "Ctrl+p": Search,
    },
    // Ctrl+p's search box: one query, an exact smart-case regex (a capital makes it match case),
    // over repos, visited folders, file names and file contents under the focused files tab's
    // folder (from git: the selected repo). repo:, dir:, file: or content: narrows it to one.
    search: (
        // $1 is the file; open_line also gets the line as $2.
        open: r#"${EDITOR:-nvim} "$1""#,
        open_line: r#"${EDITOR:-nvim} +"$2" "$1""#,
        // Hidden files are where dotfiles live (~/.config), so they're searched, minus these
        // globs: git's own store, and caches and app data that would bury everything from ~.
        hidden: true,
        exclude: [".git", ".cache", ".local/share", ".local/state", ".cargo", ".rustup", ".npm", ".mozilla", ".zen", "node_modules"],
        style: (
            section: (fg: "#89b4fa", bold: true),
            line_number: (fg: "#6c7086"),
            cursor: (bg: "#45475a"),
        ),
        // Unbound printable keys type into the query.
        keys: {
            "Down": Down, "Ctrl+j": Down, "Ctrl+n": Down,
            "Up": Up, "Ctrl+k": Up,
            "Enter": Open, "Ctrl+r": Reveal, "Esc": Close,
            "Backspace": DeleteChar, "Ctrl+w": DeleteWord, "Ctrl+u": Clear,
        },
    ),
    // While the ? menu of key bindings is up. Other keys do nothing.
    help_keys: {
        "j": Down, "k": Up, "Down": Down, "Up": Up,
        "Ctrl+d": PageDown, "Ctrl+u": PageUp, "PageDown": PageDown, "PageUp": PageUp,
        "g g": Top, "G": Bottom,
        "Esc": Close, "q": Close, "?": Close,
    },
)
